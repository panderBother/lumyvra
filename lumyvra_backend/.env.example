# Copy to .env in this directory. The server loads it at startup.
# Existing process environment variables take precedence. Restart after changes.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/lumyvra.db
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
# Email verification: use your mail provider's SMTP credentials/app password.
# 587 + starttls, or 465 + tls. Unencrypted SMTP is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Plain sender email address, approved by your SMTP provider.
SMTP_FROM=
# Google Cloud OAuth client (Web application). Keep the secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

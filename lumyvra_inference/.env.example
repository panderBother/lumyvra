# Go and this private service must share the same key. Do not put it in the browser.
INFERENCE_API_KEY=
INFERENCE_DATA_DIR=data
INFERENCE_ENGINE_PYTHON=vendor/ACE-Step-1.5/.venv/Scripts/python.exe
INFERENCE_ACE_ROOT=vendor/ACE-Step-1.5
INFERENCE_CHECKPOINTS_DIR=checkpoints
INFERENCE_MODEL=acestep-v15-turbo
INFERENCE_DEVICE=cuda
# Optional separate music-planning process. Prepare its model explicitly before enabling.
INFERENCE_COMPOSITION_ENABLED=false
INFERENCE_COMPOSITION_MODEL=acestep-5Hz-lm-0.6B
# Influence of semantic music codes; 1 keeps the previous behavior. Tune after listening.
INFERENCE_COMPOSITION_STRENGTH=1.0
# Optional project taste, applied to pop/R&B planning; explicit user requests take priority.
INFERENCE_SONGWRITING_PROFILE=balanced
INFERENCE_MAX_SECONDS=240
INFERENCE_TIMEOUT_SECONDS=3600
# Never fetch weights during a generation request. Use scripts/prepare_models.py explicitly.
# Existing OpenAI-compatible GLM endpoint, supplied by the user (no automatic paid fallback).
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=GLM-5.3-Flash
GLM_TIMEOUT_SECONDS=180
